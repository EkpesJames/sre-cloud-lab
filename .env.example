# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in real values
# NEVER commit .env to git — only commit this file
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE
SLACK_CHANNEL=#general

# ── Email (Yahoo SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
SMTP_FROM=your-email@yahoo.co.uk
SMTP_USERNAME=your-email@yahoo.co.uk
SMTP_PASSWORD=your-app-password-here

# ── Alert routing ─────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=your-email@yahoo.co.uk

# ── SLO targets (used by recording rules and dashboards) ──────────────────────
SLO_AVAILABILITY_TARGET=0.99
SLO_LATENCY_P95_TARGET_SECONDS=0.5
SLO_LATENCY_P99_TARGET_SECONDS=1.0

# ── App behaviour ─────────────────────────────────────────────────────────────
APP_ERROR_RATE=0.30
APP_LATENCY_SECONDS=0.2
